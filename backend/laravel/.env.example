APP_NAME=GrocerEase
# Optional AI provider. Keep these backend-only; leave blank for local text matching.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT=12
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grocerease
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_LOG_CHANNEL=single
MAIL_FROM_ADDRESS="no-reply@grocerease.test"
MAIL_FROM_NAME="${APP_NAME}"

# Disabled by default. Backend-only secrets; authorize exactly this store/merchant pair.
PAYMENT_GATEWAY_MODE=disabled
PAYMONGO_TEST_STORE_ID=
PAYMONGO_TEST_MERCHANT_ID=
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_TEST_METHODS=

# New Xendit TEST setup (never place secret keys in frontend env).
PAYMENT_GATEWAY_PROVIDER=xendit
XENDIT_TEST_STORE_ID=
XENDIT_TEST_BUSINESS_ID=
XENDIT_TEST_SECRET_KEY=
XENDIT_TEST_WEBHOOK_TOKEN=
XENDIT_TEST_CHANNELS=GCASH
# For a local Vite HTTPS tunnel only: set exact loopback proxy IPs in your local env.
GROCEREASE_TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
